# 复制本文件为 .env 并填入真实值（.env 已被 gitignore，不会入库）
# 接入任何 OpenAI 兼容端点：官方 / Azure / 第三方中转 / 本地 vLLM 等

# ---- 必填 ----
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here

# ---- 可选（不填则用 sro/config.py 中的默认值）----
# 模型与超时
TASK_MODEL=gpt-4o-mini
REFLECTION_MODEL=gpt-4o-mini
TASK_TIMEOUT=200
REFLECTION_TIMEOUT=60

# API 调用参数（移植自 gepa_aime_v2.py；task / reflection 各一套）
# 采样温度：task 默认 0.0（确定性），reflection 默认 0.7（多样性）
TASK_TEMPERATURE=0.0
REFLECTION_TEMPERATURE=0.7
# 单次最大输出 token 数
TASK_MAX_TOKENS=4096
REFLECTION_MAX_TOKENS=2048
# 思考模式：true 开启（qwen3/qwq 走流式聚合，glm 走 reasoning，其他走 reasoning_effort）
#            false 关闭（qwen3-8b/14b 等默认开思考的模型自动注入关闭，避免 400）
TASK_ENABLE_THINKING=false
REFLECTION_ENABLE_THINKING=false
# 最大上下文长度（0=不限制；>0 注入 max_model_len）
TASK_MAX_CONTEXT_LEN=0
REFLECTION_MAX_CONTEXT_LEN=0
# 额外 API 参数（JSON 字符串，task/reflection 共享）。例：{"top_p":0.9,"presence_penalty":0.6}
EXTRA_PARAMS=

# Embedding（本地 sentence-transformers，不依赖中转端点）
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# 检索 / 匹配
MATCH_THRESHOLD=0.6
TOP_K=3

# 实验参数（数据规模 / 训练轮次 / 开关；命令行可覆盖）
N_TRAIN=50
N_VAL=30
N_ITERS=3
SEED=42
# 测试时不匹配是否走动态学习（true 开 / false 直接用长期策略硬答）
DYNAMIC_LEARNING=true
# 测试时是否注入 KB 短期规律作 context（true 命中注入 / false 全程只用长期策略；
# 与 DYNAMIC_LEARNING 独立——关闭后命中分支不触发，但 miss 时仍可按 dynamic_learning 归纳）
TEST_USE_PATTERNS=true

# ---- 进化模式与训练期检索 ----
# 进化模式：classic（n_iters 轮全量跑） / gepa（Pareto+minibatch+预算控制）
EVO_MODE=classic
# 训练期是否从 KB 检索短期规律作 few-shot 上下文（第89行自递归上下文开关）
TRAIN_RETRIEVE_CTX=true
# GEPA 专属参数（仅 EVO_MODE=gepa 时生效）
MAX_METRIC_CALLS=150
MINIBATCH_SIZE=8
MAX_PROMPT_LENGTH=2000

# ---- API 重试（服务端临时故障自动重试，不改动上层训练逻辑）----
# 可重试错误（5xx / 连接 / 限流 / 超时）自动指数退避重试；
# 4xx 客户端错误（请求本身有问题）不重试直接抛。
# 0=关闭重试（遇错即抛，与旧行为一致）；3=最多重试 3 次（共 4 次请求）
MAX_RETRIES=3
# 指数退避基数（秒）：第 n 次重试等待 base^n × (1±0.25 抖动)。
# base=2 → 第1次等 ~2s，第2次 ~4s，第3次 ~8s
RETRY_BACKOFF_BASE=2

# ---- 短期规律生成 ----
# basic：现状（wrong[:3]+correct[:3] 各 1 角度，每 reflect 最多 6 条，轨迹截 200 字符）
# rich ：多角度提取（wrong/correct 各 2 角度：错误定位+避坑 / 有效做法+触发规则）
#        + batch 级错误聚类（至多 3 条），轨迹截 2000 字符，产量约 6 倍、反思调用成本约 6 倍
PATTERN_GEN_MODE=basic
# rich 模式下 wrong/correct 各取的最大 trace 数（basic 模式忽略此项，固定 3）
PATTERN_MAX_TRACES=8
# 规律入库去重阈值：>0 时与已有规律 cosine >= 阈值则跳过入库。
# basic 建议 0（关闭，保持旧行为）；rich 建议 0.92（防多轮迭代后 KB 充满近重复规律）
PATTERN_DEDUP_THRESHOLD=0.0

# ---- 测试时匹配方法 ----
# vector：纯 cosine 向量检索（现状，MATCH_THRESHOLD 判命中）
# llm   ：向量粗召回 + LLM 精选（retrieve-then-rerank）——先按相似度召回
#         LLM_MATCH_RECALL_K 条候选，再由 ReflectionLM 判断哪些真正适用于
#         该问题，选中者注入 context。每道测试题多 1 次 LLM 调用；
#         LLM 调用/解析失败时自动回落 vector 匹配。
TEST_MATCH_METHOD=vector
# llm 模式的粗召回候选数（vector 模式忽略此项）
LLM_MATCH_RECALL_K=10

# 数据集本地路径（不填则用默认 ../<name>/，相对 SRO 仓库根）
# GSM8K_PATH=../gsm8k/main
# MATH_PATH=../MATH
# HOTPOTQA_PATH=../HotpotQA/raw
# AIME_PATH=../AIME
# AIME 专用：复刻 GEPA init_dataset() 划分（seed=0 对半切 + ### 答案前缀）。
# 仅 dataset=aime 生效，true 时忽略 N_TRAIN/N_VAL/SEED 对 AIME 的作用。
AIME_GEPA_SPLIT=false
